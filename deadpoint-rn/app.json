{
  "expo": {
    "name": "Deadpoint",
    "slug": "deadpoint",
    "scheme": "deadpointrn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.sullivanltd.crimpblock",
      "buildNumber": "20",
      "entitlements": {
        "com.apple.security.application-groups": ["group.uk.co.sullivanltd.crimpblock"]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "uk.co.sullivanltd.deadpoint",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6423a1c3-8565-486f-aa4c-32f7f4c68098"
      }
    },
    "owner": "oscarpoints-team"
  }
}
