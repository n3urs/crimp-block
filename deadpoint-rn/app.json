{
  "expo": {
    "name": "Deadpoint",
    "slug": "deadpoint",
    "scheme": "deadpointrn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.sullivanltd.crimpblock",
      "buildNumber": "27",
      "appleTeamId": "87F48SV42Q",
      "entitlements": {
        "com.apple.security.application-groups": ["group.uk.co.sullivanltd.crimpblock"]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "uk.co.sullivanltd.deadpoint",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["expo-audio", { "enableBackgroundPlayback": false }],
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets",
      "./plugins/withAndroidPhoneOnly"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6423a1c3-8565-486f-aa4c-32f7f4c68098"
      }
    },
    "owner": "oscarpoints-team"
  }
}
